# Example .env for local development. Do NOT commit secrets to public repos.
# Copy to .env and fill values before running docker compose up

# SQL Server SA password (must meet complexity requirements)
SA_PASSWORD=Grup0D!reCional2026

# Port mapping for host -> container (host side)
DB_PORT=14333
TEST_DB_PORT=14333

# Testcontainer helpers
TEST_DB_SA_PASSWORD=${SA_PASSWORD}

# JWT settings
JWT__KEY=very_secret_key_replace_this_in_production
JWT__ISSUER=DesafioTecnicoApi
JWT__AUDIENCE=DesafioTecnicoApiUsers
JWT__EXPIRY_MINUTES=60
